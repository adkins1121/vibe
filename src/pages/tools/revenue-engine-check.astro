---
import Base from '../../layouts/Base.astro';
import { phases, qualifiers, questions } from '../../data/quiz.js';

const phaseQuestions = phases.map((p) => ({
  ...p,
  questions: questions.filter((q) => q.phase === p.id),
}));
const totalSteps = phases.length; // 6 question screens
---

<Base
  pageLabel="Revenue Engine Check"
  description="A free 3-minute diagnostic that scores all six phases of your revenue engine and names the one that’s leaking. No email to take it."
>
  <div class="rec" id="rec" data-step="intro">
    <!-- Progress (shown during quiz) -->
    <div class="rec__progress" id="rec-progress" hidden>
      <div class="wrap rec__progress-inner">
        <span class="rec__progress-label" id="rec-progress-label">Qualifiers</span>
        <div class="rec__progress-track">
          <div class="rec__progress-fill" id="rec-progress-fill"></div>
        </div>
      </div>
    </div>

    <!-- ===== Intro ===== -->
    <section class="rec-screen" data-screen="intro">
      <div class="wrap-narrow">
        <span class="eyebrow">The Revenue Engine Check</span>
        <h1>Score your revenue engine in three minutes.</h1>
        <p class="lede">
          Twelve questions across the six phases of a B2B revenue engine — from who you
          sell to, to whether your AI seats are doing real work. You’ll get a score for
          each phase, your weakest link named, and the one move that matters most.
        </p>
        <ul class="rec-facts">
          <li><strong>No email to take it.</strong> Play with it. The email only gates the full PDF report.</li>
          <li><strong>3 minutes.</strong> Twelve questions, one tap each.</li>
          <li><strong>Built for founder-led B2B, $1–50M.</strong> Outside that, I’ll tell you honestly.</li>
        </ul>
        <button class="btn btn--solid btn--lg" data-action="start">Start the check →</button>
        <p class="rec-resume text-secondary" id="rec-resume" hidden>
          You have answers saved. <button class="linkbtn" data-action="resume">Resume where you left off →</button>
        </p>
      </div>
    </section>

    <!-- ===== Qualifiers ===== -->
    <section class="rec-screen" data-screen="qualifiers" hidden>
      <div class="wrap-narrow">
        <span class="eyebrow eyebrow--muted">First — is this even for you?</span>
        <h2>Three quick qualifiers.</h2>
        <p class="text-secondary">Unscored. They just make sure I’m the right person to read your result.</p>

        {Object.values(qualifiers).map((q) => (
          <fieldset class="rec-qual" data-qual={q.id}>
            <legend>{q.label}</legend>
            <div class="rec-qual__opts">
              {q.options.map((opt) => (
                <label class="rec-chip">
                  <input type="radio" name={q.id} value={opt.value} />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}

        <div class="rec-nav">
          <button class="btn btn--ghost btn--md" data-action="to-intro">← Back</button>
          <button class="btn btn--solid btn--md" data-action="qualifiers-next" disabled>Continue →</button>
        </div>
      </div>
    </section>

    <!-- ===== Question screens (one per phase) ===== -->
    {phaseQuestions.map((p, i) => (
      <section class="rec-screen" data-screen="phase" data-phase-index={i} hidden>
        <div class="wrap-narrow">
          <span class="eyebrow">{`Phase ${i + 1} of ${totalSteps}`} · {p.name}</span>
          <h2 class="rec-phase__measures">{p.measures}.</h2>

          {p.questions.map((q) => (
            <fieldset class="rec-q" data-q={q.id}>
              <legend>{q.text}</legend>
              <div class="rec-q__opts">
                {q.options.map((opt, score) => (
                  <label class="rec-opt">
                    <input type="radio" name={q.id} value={score} />
                    <span class="rec-opt__dot" aria-hidden="true"></span>
                    <span class="rec-opt__text">{opt}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <div class="rec-nav">
            <button class="btn btn--ghost btn--md" data-action="phase-back">← Back</button>
            <button class="btn btn--solid btn--md" data-action="phase-next" disabled>
              {i === totalSteps - 1 ? 'See my results →' : 'Next →'}
            </button>
          </div>
        </div>
      </section>
    ))}

    <!-- ===== Disqualified ===== -->
    <section class="rec-screen" data-screen="disqualified" hidden>
      <div class="wrap-narrow">
        <span class="eyebrow eyebrow--muted">Straight with you</span>
        <h2>This isn’t what I do — and that’s worth knowing now.</h2>
        <p class="lede" id="rec-dq-reason"></p>
        <p>
          No score to give you here, because my patterns wouldn’t fit your situation and
          I’d rather not pretend otherwise. Here’s where I’d point you instead.
        </p>
        <p><a href="/not-a-fit" class="btn btn--ghost btn--md">See what I’d read instead →</a></p>
      </div>
    </section>

    <!-- ===== Results ===== -->
    <section class="rec-screen rec-results" data-screen="results" hidden>
      <div class="wrap">
        <div class="rec-results__head">
          <span class="eyebrow" id="rec-grade-eyebrow">Your result</span>
          <h2 class="rec-grade__label" id="rec-grade-label"></h2>
          <p class="rec-grade__score" id="rec-grade-score"></p>
          <p class="lede rec-grade__copy" id="rec-grade-copy"></p>
        </div>

        <div class="rec-results__grid">
          <!-- Phase bars -->
          <div class="rec-bars" id="rec-bars" aria-label="Phase scores"></div>

          <!-- Routing + capture -->
          <aside class="rec-route">
            <div class="rec-route__card">
              <p class="rec-route__hook" id="rec-route-hook"></p>
              <a class="btn btn--solid btn--lg rec-route__primary" id="rec-route-primary" href="#"></a>
              <a class="rec-route__secondary" id="rec-route-secondary" href="#"></a>
            </div>

            <!-- Email gate on the PDF (not the quiz) -->
            <form class="rec-capture" id="rec-capture">
              <p class="rec-capture__label">Get the full report with fix-first recommendations</p>
              <div class="rec-capture__row">
                <input type="email" id="rec-email" name="email" placeholder="you@company.com" required autocomplete="email" />
                <button type="submit" class="btn btn--solid btn--md">Send the PDF</button>
              </div>
              <p class="rec-capture__note text-muted">
                One report, plus a short follow-up on your weakest phase. No list-selling.
                See <a href="/privacy">privacy</a>.
              </p>
              <p class="rec-capture__done" id="rec-capture-done" hidden>
                Done — check your inbox. You can also
                <button type="button" class="linkbtn" data-action="print">print the report to PDF →</button>
              </p>
            </form>
          </aside>
        </div>

        <div class="rec-results__foot">
          <button class="linkbtn" data-action="print">Print this report to PDF</button>
          <button class="linkbtn" data-action="restart">Start over</button>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { computeResult, isDisqualified, isEdgeBand } from '../../lib/score.js';
  import { phases, qualifiers } from '../../data/quiz.js';

  const STORAGE_KEY = 'altus-rec-v1';
  const root = document.getElementById('rec');
  const screens = Array.from(root.querySelectorAll('[data-screen]'));
  const progress = document.getElementById('rec-progress');
  const progressFill = document.getElementById('rec-progress-fill');
  const progressLabel = document.getElementById('rec-progress-label');
  const phaseScreens = screens.filter((s) => s.dataset.screen === 'phase');
  const TOTAL_PHASES = phaseScreens.length;

  // ---- State ----
  let state = load() || { quals: {}, answers: {}, phaseIndex: 0 };

  function load() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)); } catch { return null; }
  }
  function save() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
  }
  function clearSaved() {
    try { localStorage.removeItem(STORAGE_KEY); } catch {}
  }

  // ---- Screen control ----
  function show(name, phaseIndex = 0) {
    screens.forEach((s) => {
      const match = s.dataset.screen === name &&
        (name !== 'phase' || Number(s.dataset.phaseIndex) === phaseIndex);
      s.hidden = !match;
    });
    const inQuiz = name === 'qualifiers' || name === 'phase';
    progress.hidden = !inQuiz;
    if (inQuiz) updateProgress(name, phaseIndex);
    root.dataset.step = name === 'phase' ? `phase-${phaseIndex}` : name;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress(name, phaseIndex) {
    const step = name === 'qualifiers' ? 0 : phaseIndex + 1;
    const totalSegments = TOTAL_PHASES + 1; // qualifiers + phases
    progressFill.style.width = `${(step / totalSegments) * 100}%`;
    progressLabel.textContent = name === 'qualifiers'
      ? 'Qualifiers'
      : `Phase ${phaseIndex + 1} of ${TOTAL_PHASES} · ${phases[phaseIndex].name}`;
  }

  // ---- Restore selections into the DOM ----
  function restoreSelections() {
    for (const [k, v] of Object.entries(state.quals)) {
      const el = root.querySelector(`input[name="${k}"][value="${v}"]`);
      if (el) el.checked = true;
    }
    for (const [k, v] of Object.entries(state.answers)) {
      const el = root.querySelector(`input[name="${k}"][value="${v}"]`);
      if (el) el.checked = true;
    }
    refreshQualifiersValid();
    phaseScreens.forEach((s) => refreshPhaseValid(Number(s.dataset.phaseIndex)));
  }

  // ---- Validation gates ----
  const qualIds = Object.values(qualifiers).map((q) => q.id);
  function refreshQualifiersValid() {
    const ok = qualIds.every((id) => state.quals[id] != null);
    root.querySelector('[data-action="qualifiers-next"]').disabled = !ok;
  }
  function questionsForPhase(i) {
    return phaseScreens[i].querySelectorAll('fieldset[data-q]');
  }
  function refreshPhaseValid(i) {
    const ids = Array.from(questionsForPhase(i)).map((f) => f.dataset.q);
    const ok = ids.every((id) => state.answers[id] != null);
    phaseScreens[i].querySelector('[data-action="phase-next"]').disabled = !ok;
  }

  // ---- Input handling ----
  root.addEventListener('change', (e) => {
    const input = e.target;
    if (input.type !== 'radio') return;
    const name = input.name;
    if (qualIds.includes(name)) {
      state.quals[name] = input.value;
      refreshQualifiersValid();
    } else {
      state.answers[name] = Number(input.value);
      const idx = Number(input.closest('[data-screen="phase"]').dataset.phaseIndex);
      refreshPhaseValid(idx);
    }
    save();
  });

  // ---- Actions ----
  root.addEventListener('click', (e) => {
    const action = e.target.closest('[data-action]')?.dataset.action;
    if (!action) return;

    switch (action) {
      case 'start':
        show('qualifiers');
        break;
      case 'resume':
        resume();
        break;
      case 'to-intro':
        show('intro');
        break;
      case 'qualifiers-next': {
        if (isDisqualified(state.quals)) { showDisqualified(); break; }
        state.phaseIndex = 0;
        save();
        show('phase', 0);
        break;
      }
      case 'phase-next': {
        const i = Number(e.target.closest('[data-screen="phase"]').dataset.phaseIndex);
        if (i < TOTAL_PHASES - 1) {
          state.phaseIndex = i + 1; save();
          show('phase', i + 1);
        } else {
          renderResults();
          show('results');
        }
        break;
      }
      case 'phase-back': {
        const i = Number(e.target.closest('[data-screen="phase"]').dataset.phaseIndex);
        if (i === 0) show('qualifiers');
        else { state.phaseIndex = i - 1; save(); show('phase', i - 1); }
        break;
      }
      case 'print':
        window.print();
        break;
      case 'restart':
        clearSaved();
        state = { quals: {}, answers: {}, phaseIndex: 0 };
        root.querySelectorAll('input[type="radio"]').forEach((r) => (r.checked = false));
        document.getElementById('rec-capture-done').hidden = true;
        show('intro');
        break;
    }
  });

  function resume() {
    // Jump to first incomplete phase, or results if all answered.
    restoreSelections();
    if (!qualIds.every((id) => state.quals[id] != null)) { show('qualifiers'); return; }
    if (isDisqualified(state.quals)) { showDisqualified(); return; }
    for (let i = 0; i < TOTAL_PHASES; i++) {
      const ids = Array.from(questionsForPhase(i)).map((f) => f.dataset.q);
      if (!ids.every((id) => state.answers[id] != null)) { show('phase', i); return; }
    }
    renderResults();
    show('results');
  }

  function showDisqualified() {
    const band = state.quals.revenue_band;
    const model = state.quals.model;
    let reason = 'Based on what you told me, we’re not a match right now.';
    if (band === 'pre') reason = 'You’re pre-revenue or under $1M — at this stage you need customers and a repeatable first sale, not a fractional revenue operator. That’s a different (and earlier) job.';
    else if (band === '50+') reason = 'You’re past $50M — at your scale you need a VP you hire and own, not a fractional one. I’d be the wrong shape for the problem.';
    else if (model === 'b2c') reason = 'You’re B2C / consumer — my patterns are built on B2B motions, and they don’t transfer cleanly. I’d be guessing, and you deserve someone who isn’t.';
    document.getElementById('rec-dq-reason').textContent = reason;
    show('disqualified');
  }

  // ---- Results rendering ----
  function renderResults() {
    const result = computeResult(state.answers);
    const { scores, overall, grade, route, secondary, weakest } = result;

    document.getElementById('rec-grade-label').textContent = grade.label;
    document.getElementById('rec-grade-score').textContent = `${overall} / 36 overall`;
    document.getElementById('rec-grade-copy').textContent = grade.copy;

    // Phase bars
    const bars = document.getElementById('rec-bars');
    bars.innerHTML = '';
    for (const p of phases) {
      const isWeak = p.id === weakest.id;
      const val = scores[p.id];
      const wrap = document.createElement('div');
      wrap.className = 'rec-bar' + (isWeak ? ' rec-bar--weak' : '');
      const segs = Array.from({ length: 6 }, (_, n) =>
        `<span class="rec-bar__seg${n < val ? ' on' : ''}"></span>`).join('');
      wrap.innerHTML = `
        <div class="rec-bar__head">
          <span class="rec-bar__name">${p.name}${isWeak ? '<em>weakest phase</em>' : ''}</span>
          <span class="rec-bar__score">${val}<i>/6</i></span>
        </div>
        <div class="rec-bar__track">${segs}</div>`;
      bars.appendChild(wrap);
    }

    // Routing CTAs
    document.getElementById('rec-route-hook').textContent = route.hook;
    const primary = document.getElementById('rec-route-primary');
    primary.textContent = route.primaryLabel;
    primary.href = route.primaryHref;
    const sec = document.getElementById('rec-route-secondary');
    sec.textContent = secondary.label;
    sec.href = secondary.href;

    // Stash for HubSpot submit
    root._result = result;
  }

  // ---- Email capture → HubSpot Forms API (PDF gate) ----
  const captureForm = document.getElementById('rec-capture');
  captureForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('rec-email').value.trim();
    if (!email) return;
    const result = root._result || computeResult(state.answers);
    await submitToHubSpot(email, result);
    // Capture is best-effort — never block the visitor's report on a CRM hiccup.
    document.getElementById('rec-capture-done').hidden = false;
    captureForm.querySelector('.rec-capture__row').hidden = true;
    captureForm.querySelector('.rec-capture__note').hidden = true;
  });

  // Post to the Cloudflare Pages Function (functions/api/submit.js), which upserts
  // the contact in HubSpot with a server-side private-app token. On local static
  // preview the endpoint 404s — caught and logged, so the flow stays demonstrable.
  async function submitToHubSpot(email, result) {
    const { scores, overall, grade, routeKey } = result;
    const body = {
      kind: 'rec',
      email,
      rec_p1: scores.P1, rec_p2: scores.P2, rec_p3: scores.P3,
      rec_p4: scores.P4, rec_p5: scores.P5, rec_p6: scores.P6,
      rec_overall: overall,
      rec_grade: grade.label,
      rec_route: routeKey,
      revenue_band: state.quals.revenue_band || '',
      edge_band: isEdgeBand(state.quals),
    };
    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) console.warn('[REC] capture not OK', res.status);
    } catch (err) {
      console.info('[REC] capture endpoint unavailable (expected on static preview)', body);
    }
  }

  // ---- Init ----
  const hasProgress = (state.answers && Object.keys(state.answers).length > 0) ||
    (state.quals && Object.keys(state.quals).length > 0);
  if (hasProgress) {
    restoreSelections();
    document.getElementById('rec-resume').hidden = false;
  }
  show('intro');
</script>

<style>
  .rec { min-height: 60vh; }

  /* Progress */
  .rec__progress {
    position: sticky;
    top: 68px;
    z-index: 40;
    background: var(--cream);
    border-bottom: 1px solid var(--border);
    padding-block: 0.8rem;
  }
  .rec__progress-inner { display: flex; align-items: center; gap: 1rem; }
  .rec__progress-label {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .rec__progress-track { flex: 1; height: 4px; background: var(--card-hover); border-radius: 2px; overflow: hidden; }
  .rec__progress-fill { height: 100%; width: 0; background: var(--accent); transition: width 0.3s ease; }

  .rec-screen { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .rec-screen h1 { max-width: 16ch; }

  .rec-facts { list-style: none; padding: 0; margin: 2rem 0; }
  .rec-facts li {
    padding: 0.9rem 0 0.9rem 1.6rem;
    border-top: 1px solid var(--border);
    position: relative;
    max-width: none;
  }
  .rec-facts li::before {
    content: '→'; position: absolute; left: 0; color: var(--accent); font-weight: 700;
  }
  .rec-resume { margin-top: 1.4rem; }
  .linkbtn {
    background: none; border: 0; padding: 0; cursor: pointer;
    color: var(--accent); font: inherit; font-weight: 600;
    border-bottom: 1px solid transparent;
  }
  .linkbtn:hover { border-bottom-color: var(--accent); }

  /* Qualifiers */
  .rec-qual, .rec-q { border: 0; padding: 0; margin: 0 0 2rem; }
  .rec-qual legend, .rec-q legend {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--evergreen);
    margin-bottom: 1rem;
    padding: 0;
    line-height: 1.3;
  }
  .rec-qual__opts { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .rec-chip { position: relative; cursor: pointer; }
  .rec-chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .rec-chip span {
    display: inline-block;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    font-size: 0.95rem;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .rec-chip input:hover + span { border-color: var(--accent-border); }
  .rec-chip input:checked + span {
    border-color: var(--accent);
    background: var(--accent-glow);
    color: var(--evergreen);
    font-weight: 600;
  }
  .rec-chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Questions */
  .rec-phase__measures { color: var(--text-secondary); font-weight: 600; font-size: 1.25rem; margin-bottom: 2rem; }
  .rec-q__opts { display: flex; flex-direction: column; gap: 0.5rem; }
  .rec-opt {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .rec-opt:hover { border-color: var(--accent-border); }
  .rec-opt input { position: absolute; opacity: 0; width: 0; height: 0; }
  .rec-opt__dot {
    flex: none;
    width: 18px; height: 18px;
    border: 2px solid var(--text-muted);
    border-radius: 50%;
    margin-top: 2px;
    transition: border-color 0.12s ease;
  }
  .rec-opt__text { line-height: 1.4; }
  .rec-opt:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-glow);
  }
  .rec-opt:has(input:checked) .rec-opt__dot {
    border-color: var(--accent);
    background: radial-gradient(circle, var(--accent) 0 5px, transparent 6px);
  }
  .rec-opt:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  .rec-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Results */
  .rec-results__head { max-width: 720px; margin-bottom: 2.5rem; }
  .rec-grade__label { font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 0.4rem; }
  .rec-grade__score {
    font-family: var(--font-head); font-weight: 700; color: var(--accent);
    letter-spacing: 0.02em; margin-bottom: 1rem;
  }
  .rec-results__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .rec-bars { display: flex; flex-direction: column; gap: 0.7rem; }
  .rec-bar { padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--white); }
  .rec-bar--weak { border-color: var(--accent-border); background: var(--accent-glow); }
  .rec-bar__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.55rem; gap: 1rem; }
  .rec-bar__name { font-family: var(--font-head); font-weight: 600; font-size: 0.95rem; }
  .rec-bar__name em {
    font-style: normal; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent); margin-left: 0.6rem;
  }
  .rec-bar__score { font-family: var(--font-head); font-weight: 700; }
  .rec-bar__score i { color: var(--text-muted); font-style: normal; font-size: 0.78rem; }
  .rec-bar__track { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
  .rec-bar__seg { height: 8px; border-radius: 2px; background: var(--card-hover); }
  .rec-bar__seg.on { background: var(--mid-green); }
  .rec-bar--weak .rec-bar__seg.on { background: var(--accent); }

  .rec-route { position: sticky; top: 140px; display: flex; flex-direction: column; gap: 1.25rem; }
  .rec-route__card {
    background: var(--evergreen);
    color: var(--cream);
    padding: 1.6rem;
    border-radius: var(--radius);
  }
  .rec-route__hook { color: var(--cream); font-size: 1.05rem; line-height: 1.5; margin-bottom: 1.4rem; }
  .rec-route__primary { width: 100%; }
  .rec-route__secondary {
    display: block; text-align: center; margin-top: 1rem;
    color: rgba(246, 243, 238, 0.8); font-size: 0.9rem; border-bottom: 0;
