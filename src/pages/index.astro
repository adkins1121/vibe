---
import Base from '../layouts/Base.astro';
import CTAButton from '../components/CTAButton.astro';
import Card from '../components/Card.astro';
import { engagements } from '../data/engagements.js';
---

<Base
  pageLabel="Home"
  description="A fractional operating partner who fixes broken revenue engines for founder-led B2B companies. Operator, not advisor. Kansas City."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Fractional revenue operator · Kansas City</span>
      <h1 class="hero__h1">
        A fractional operating partner who fixes broken revenue engines for founder-led B2B companies.
      </h1>
      <p class="lede hero__sub">
        Operator, not advisor. I don’t hand you a deck and a retainer — I take revenue
        off the founder’s back and build the engine that runs without you.
      </p>
      <div class="hero__cta">
        <CTAButton href="/tools/revenue-engine-check" size="lg">
          Run the Revenue Engine Check (3 minutes)
        </CTAButton>
        <span class="hero__cta-note text-secondary">Free · no email to take it</span>
      </div>
    </div>
  </section>

  <!-- Engagement cards -->
  <section class="section-tight">
    <div class="wrap">
      <span class="eyebrow eyebrow--muted">How I work</span>
      <h2>Three ways in. Each one ends in a working engine.</h2>
      <div class="eng-grid">
        {engagements.map((e) => (
          <Card href="/how-i-work" class="eng-card">
            <p class="eng-card__price">{e.price}</p>
            <h3 class="eng-card__name">{e.name}</h3>
            <p class="text-secondary eng-card__tag">{e.tagline}</p>
            <span class="eng-card__more">How I work →</span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="proof-strip">
    <div class="wrap">
      <span class="eyebrow">Proof</span>
      <h2 class="proof-strip__h2">Pattern recognition, not promises.</h2>
      <div class="proof-strip__grid">
        <div class="proof-stat">
          <p class="proof-stat__big">6 phases</p>
          <p class="text-secondary">of the revenue engine — diagnosed the same way every time, from ICP to AI leverage.</p>
        </div>
        <div class="proof-stat">
          <p class="proof-stat__big">B2B, $1–50M</p>
          <p class="text-secondary">founder-led companies in logistics, freight, and supply chain. The intersection I own.</p>
        </div>
        <div class="proof-stat">
          <p class="proof-stat__big">Operator</p>
          <p class="text-secondary">I build and ship inside the business — AI workflows in production, not slideware.</p>
        </div>
      </div>
      <p class="proof-strip__link">
        <a href="/proof">See the teardowns →</a>
      </p>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="closer">
    <div class="wrap-narrow center">
      <h2 class="closer__h2">Not sure where your engine is leaking?</h2>
      <p class="lede mx-auto" style="margin-inline:auto;">
        The Revenue Engine Check scores all six phases in three minutes and tells you
        the weakest one by name. That’s where the revenue is going.
      </p>
      <div class="closer__cta">
        <CTAButton href="/tools/revenue-engine-check" size="lg">Run the Revenue Engine Check</CTAButton>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    background:
      radial-gradient(120% 90% at 78% -10%, var(--accent-glow), transparent 60%);
  }
  .hero__h1 { max-width: 16ch; }
  .hero__sub { margin-top: 1.4rem; }
  .hero__cta {
    margin-top: 2.2rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .hero__cta-note { font-size: 0.9rem; }

  .eng-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .eng-card { display: flex; flex-direction: column; }
  .eng-card__price {
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.7rem;
  }
  .eng-card__name { margin-bottom: 0.6rem; }
  .eng-card__tag { margin-bottom: 1.2rem; flex: 1; }
  .eng-card__more {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent);
  }

  .proof-strip { background: var(--card-bg); border-block: 1px solid var(--border); }
  .proof-strip__h2 { margin-bottom: 2rem; }
  .proof-strip__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .proof-stat__big {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--evergreen);
    margin: 0 0 0.4rem;
  }
  .proof-strip__link { margin-top: 2rem; }
  .proof-strip__link a { font-family: var(--font-head); font-weight: 700; }

  .closer__h2 { margin-top: 0; }
  .closer__cta { margin-top: 2rem; }

  @media (max-width: 820px) {
    .eng-grid { grid-template-columns: 1fr; }
    .proof-strip__grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
