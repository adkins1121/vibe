---
// Typographic wordmark — Montserrat 800, 0.18em tracking.
// ALTUS in evergreen, KC in accent. Used until logo SVGs land.
interface Props {
  size?: 'sm' | 'md' | 'lg';
  href?: string | null;
}
const { size = 'md', href = '/' } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class={`wordmark wordmark--${size}`} {...(href ? { href } : {})} aria-label="Altus KC">
  <span class="wordmark__altus">ALTUS</span><span class="wordmark__kc">KC</span>
</Tag>

<style>
  .wordmark {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--evergreen);
    border-bottom: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    line-height: 1;
  }
  .wordmark:hover { border-bottom: 0; }
  .wordmark--sm { font-size: 1rem; }
  .wordmark--md { font-size: 1.25rem; }
  .wordmark--lg { font-size: clamp(1.5rem, 4vw, 2.25rem); }
  .wordmark__kc { color: var(--accent); }
</style>
