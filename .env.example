# Altus KC — build-time PUBLIC config (embedded in the static client bundle).
# Copy to `.env` for local dev; set the same key in Cloudflare Pages → Settings →
# Environment variables for production.

# Booking link for the discovery call (Cal.com or Calendly)
PUBLIC_BOOKING_URL=https://cal.com/altus-kc/discovery

# ---------------------------------------------------------------------------
# SERVER-SIDE SECRET — do NOT put this here or in any committed file.
# Lead capture runs through the Cloudflare Pages Function (functions/api/submit.js),
# which reads HUBSPOT_PRIVATE_APP_TOKEN from the environment. Set it as a secret:
#   • Production:  Cloudflare Pages → Settings → Environment variables → "Encrypt"
#   • Local test:  put it in `.dev.vars` (gitignored) and run `wrangler pages dev`
#
# HubSpot portal ID for reference: 244733039
# See docs/hubspot-setup.md for the private-app + custom-property recipe.
# ---------------------------------------------------------------------------
