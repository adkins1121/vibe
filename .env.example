# Altus KC — build-time public config.
# Copy to `.env` for local dev; set the same keys in Cloudflare Pages → Settings →
# Environment variables for production. All are PUBLIC_ (embedded in the client bundle) —
# safe to expose: HubSpot Forms API submissions are public by design.

# HubSpot portal/account ID (confirmed June 2026)
PUBLIC_HUBSPOT_PORTAL_ID=244733039

# Form GUIDs — create the two forms in HubSpot (see docs/hubspot-setup.md), then paste here.
PUBLIC_HUBSPOT_REC_FORM_ID=
PUBLIC_HUBSPOT_BENCH_FORM_ID=

# Booking link for the discovery call (Cal.com or Calendly)
PUBLIC_BOOKING_URL=https://cal.com/altus-kc/discovery
