# Altus KC — build-time PUBLIC config (embedded in the static client bundle).
# Copy to `.env` for local dev; set the same key in Cloudflare Pages → Settings →
# Environment variables for production.

# Booking link for the discovery call (TidyCal / Cal.com / Calendly)
PUBLIC_BOOKING_URL=https://tidycal.com/madkins/60-min-mike-adkins

# ---------------------------------------------------------------------------
# SERVER-SIDE SECRETS — do NOT put these here or in any committed file.
# Lead capture runs through the Cloudflare Pages Function (functions/api/submit.js),
# which fans out to Slack and/or HubSpot (each optional). Set as encrypted secrets:
#   • Production:  Cloudflare Pages → Settings → Environment variables → "Encrypt"
#       SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#       SLACK_BENCH_WEBHOOK_URL=...            (optional, separate bench channel)
#       HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-...  (writes JSON to hs_content_membership_notes)
#   • Local test:  put them in `.dev.vars` (gitignored), then `wrangler pages dev ./dist`
#
# HubSpot uses the standard hs_content_membership_notes property — no custom
# properties, no plan upgrade. See docs/capture-setup.md.
# ---------------------------------------------------------------------------
